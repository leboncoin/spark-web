{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["vite.config.ts"]
}
