{
  "name": "spark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare": "husky install",
    "postinstall": "nx run-many -t build",
    "clean": "nx reset && find packages -type d -name dist -prune -exec rm -rf {} +",
    "build": "nx run-many -t build",
    "build:watch": "nx watch -- nx run-many -t build",
    "release": "nx release --yes",
    "release:beta": "node bin/release-beta.js",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build -o dist",
    "build-storybook": "storybook build -o dist",
    "test": "vitest",
    "test:ui": "vitest watch --ui",
    "test:run": "vitest run",
    "test:coverage": "rm -rf ./dist/coverage && vitest run --coverage --coverage.provider=v8",
    "test:coverage:open": "npx open-cli ./dist/coverage/index.html",
    "test:e2e": "npx playwright install && npx playwright test --grep-invert 'should not have any accessibility issues'",
    "test:e2e:visual": "npx playwright install && npx playwright test --ui",
    "test:a11y": "npx playwright install && node e2e/a11y/run-a11y-tests.cjs",
    "typecheck": "tsgo --noEmit",
    "typecheck:legacy": "tsc --noEmit",
    "commit": "git-cz",
    "lint": "oxlint -c .oxlintrc.json packages documentation",
    "lint:fix": "oxlint -c .oxlintrc.json packages documentation --fix",
    "lint:staged": "lint-staged --config .lintstagedrc.json",
    "format": "oxfmt \"packages/**/*.{ts,tsx,js,mjs}\" \"documentation/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"packages/**/*.{ts,tsx,js,mjs}\" \"documentation/**/*.{ts,tsx}\"",
    "prettify": "npm run lint && npm run format",
    "node:check": "node bin/check-node-version.js",
    "generate": "spark-generate",
    "codecov:check-yml": "cat .codecov.yml | curl --data-binary @- https://codecov.io/validate",
    "chromatic": "npx chromatic --project-token=chpt_3d05be2de334bac"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:leboncoin/spark-web.git"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@rollup/plugin-terser": "1.0.0",
    "@spark-ui/components": "^17.5.3",
    "@spark-ui/theme-utils": "^17.5.3",
    "@storybook/mcp": "^0.8.0",
    "@xyflow/react": "12.11.2",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "20.0.0",
    "@commitlint/config-workspace-scopes": "20.0.0",
    "@commitlint/cz-commitlint": "21.2.0",
    "@commitlint/prompt-cli": "20.0.0",
    "@nx/devkit": "23.1.0",
    "@nx/js": "23.1.0",
    "@playwright/test": "1.62.0",
    "@spark-ui/cli-utils": "^17.5.3",
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "10.5.4",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/d3": "7.4.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@vueless/storybook-dark-mode": "10.0.8",
    "browserslist-to-esbuild": "2.1.1",
    "chalk": "5.6.2",
    "chromatic": "^18.0.1",
    "class-variance-authority": "0.7.1",
    "commitizen": "4.3.2",
    "copy-to-clipboard": "4.0.2",
    "d3": "7.9.0",
    "husky": "9.1.7",
    "jsdom": "27.1.0",
    "lint-staged": "16.2.7",
    "nx": "23.1.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "postcss": "8.5.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "remark-gfm": "4.0.1",
    "resize-observer-polyfill": "1.5.1",
    "rollup": "4.62.3",
    "storybook": "10.5.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "workspaces": [
    "packages/hooks",
    "packages/utils/*",
    "packages/components",
    "packages/icons"
  ],
  "browserslist": [
    "> 0.5% or > 0.1% and last 2 years, not dead, not Firefox ESR, not and_qq > 0, not and_uc > 0, not and_ff >0"
  ],
  "namespaces": [
    "spark-ui"
  ],
  "engines": {
    "node": "22.x"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
